{
  "name": "flowserv-erp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "flowserv-api",
    "flowserv-web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=flowserv-api",
    "dev:web": "npm run dev --workspace=flowserv-web",
    "dev": "concurrently --raw \"npm run dev:api\" \"npm run dev:web\"",
    "db:reset": "npm run db:reset --workspace=flowserv-api"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
