# Konfigurasi Printer
# Kosongkan untuk pakai default printer Windows
# Atau isi dengan nama printer persis seperti di Windows (Contoh: EPSON TM-T82)
PRINTER_NAME=

# Lebar karakter (48 untuk 80mm, 32 untuk 58mm)
PRINTER_WIDTH=48

# Port internal server
PORT=8080

# ============================
# Konfigurasi Toko (Di Struk)
# ============================
SHOP_NAME=NAMA TOKO ANDA
SHOP_ADDRESS=Alamat Toko Lengkap
SHOP_PHONE=0812-XXXX-XXXX
SHOP_CASHIER=Admin
FOOTER_MESSAGE=TERIMA KASIH ATAS KUNJUNGAN ANDA
FOOTER_SUB_MESSAGE=Barang yang sudah dibeli tidak dapat dikembalikan
