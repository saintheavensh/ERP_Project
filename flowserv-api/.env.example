# Port the API server listens on.
PORT=3001

# PostgreSQL connection string. Replace with your local credentials.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/flowserv

# Secret used to sign JWTs. REQUIRED in any shared/production environment —
# middleware/auth.ts falls back to an insecure default if this is unset, which
# is only acceptable for solo local development.
JWT_SECRET=replace-with-a-long-random-string
