# Port the API server listens on.
PORT=3001

# Network interface the API binds to. Default 0.0.0.0 = all interfaces, so
# phones/tablets on the same WiFi can reach it at http://<host-LAN-IP>:3001
# (B2.1, go-live pilot). Set to 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0

# PostgreSQL connection string. Replace with your local credentials.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/flowserv

# Process timezone. All timestamp columns are timestamptz (H3, 2026-07-21), so this
# only controls how the Node process itself interprets/formats local wall-clock time
# (e.g. Date parsing without an offset) — set it explicitly rather than depending on
# whatever the host OS happens to be, since Phase 11 puts the API on a VPS.
TZ=Asia/Jakarta

# Secret used to sign JWTs. REQUIRED in any shared/production environment —
# middleware/auth.ts falls back to an insecure default if this is unset, which
# is only acceptable for solo local development.
JWT_SECRET=replace-with-a-long-random-string

# RBAC enforcement mode (H12). 'report' logs [RBAC] would-deny warnings but lets
# every request through. 'enforce' actually returns 403. GO-LIVE/PILOT MUST USE
# 'enforce' — otherwise per-role limits (D2 discount, admin-only settings, etc.)
# don't actually block. BREAK-GLASS: if a bad permission grant locks you out,
# set this back to 'report' and restart the server — no code change. See CLAUDE.md.
RBAC_MODE=enforce

# H15 — a SEPARATE database for the e2e integration suite (`npm run test:e2e`,
# folded into `npm test`). scripts/test-e2e.mjs drops, re-pushes, and reseeds
# whatever this points to on every run — it must never be the same database as
# DATABASE_URL above. Must contain "localhost" (same guard as db:reset).
DATABASE_URL_TEST=postgres://postgres:your_password@localhost:5432/flowserv_test
