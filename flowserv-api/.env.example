# Port the API server listens on.
PORT=3001

# PostgreSQL connection string. Replace with your local credentials.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/flowserv

# Process timezone. All timestamp columns are timestamptz (H3, 2026-07-21), so this
# only controls how the Node process itself interprets/formats local wall-clock time
# (e.g. Date parsing without an offset) — set it explicitly rather than depending on
# whatever the host OS happens to be, since Phase 11 puts the API on a VPS.
TZ=Asia/Jakarta

# Secret used to sign JWTs. REQUIRED in any shared/production environment —
# middleware/auth.ts falls back to an insecure default if this is unset, which
# is only acceptable for solo local development.
JWT_SECRET=replace-with-a-long-random-string

# RBAC enforcement mode (H12). 'report' logs [RBAC] would-deny warnings but lets
# every request through. 'enforce' actually returns 403. BREAK-GLASS: if a bad
# permission grant locks you out of the app, set this back to 'report' and
# restart the server — no code change needed. See CLAUDE.md.
RBAC_MODE=report
