# Base URL of the flowserv-api server.
#
# Local development (API on the same machine):
API_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001

# Accessing FlowServ from another device on the LAN (phone, tablet, another PC) —
# set PUBLIC_API_URL to the host machine's IP instead of localhost. On a phone,
# "localhost" means the phone itself, not your server.
# PUBLIC_API_URL=http://192.168.1.10:3001
