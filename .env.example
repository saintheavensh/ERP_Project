# FlowServ — konfigurasi Docker Compose.
#
#   cp .env.example .env
#
# Berkas .env TIDAK ikut ter-commit (lihat .gitignore). Isi nilainya di setiap
# mesin: satu untuk komputer lokal, satu lagi di VPS.

# --- Database -------------------------------------------------------------
POSTGRES_USER=flowserv
POSTGRES_DB=flowserv

# WAJIB. Buat yang acak, jangan diketik karangan sendiri:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Keamanan -------------------------------------------------------------
# WAJIB. Kunci penanda tangan token login.
#
# Sejak Phase 11, API menolak menyala di NODE_ENV=production tanpa ini —
# sengaja. Sebelumnya ada nilai cadangan yang tertulis di dalam kode yang
# di-commit, artinya siapa pun yang bisa membaca repo ini dapat memalsukan
# token untuk peran dan tenant mana pun.
#
#   openssl rand -base64 48
JWT_SECRET=

# 'enforce' (normal) atau 'report' (BREAK-GLASS).
# Kalau salah memberi izin lalu Anda sendiri terkunci di luar aplikasi: ganti ke
# 'report', restart, betulkan izinnya, lalu kembalikan ke 'enforce'.
RBAC_MODE=enforce

# --- Alamat ---------------------------------------------------------------
# WAJIB. Alamat API yang dipakai BROWSER pemakai — bukan alamat internal.
#
#   di VPS berdomain  : https://toko-anda.com/api
#   uji coba lokal    : http://localhost/api
#
# Server SSR memakai alamat yang BERBEDA (http://api:3001, disetel langsung di
# docker-compose.yml). Alasannya di flowserv-web/src/lib/api/config.server.ts.
PUBLIC_API_URL=

# --- Lain-lain ------------------------------------------------------------
TZ=Asia/Jakarta
