# Testing
coverage/

# Playwright — artefak run (screenshot, trace, error-context) tidak pernah
# di-commit; semuanya dibuat ulang tiap run.
#
# `flowserv-web/.gitignore` sudah menutup `/test-results`, TAPI hanya relatif ke
# foldernya. Menjalankan Playwright dari ROOT (mis.
# `npx playwright test --config flowserv-web/playwright.config.ts`) menaruh
# artefaknya di `test-results/` root, yang tidak tertutup pola mana pun — dan
# 8 berkas sampah sempat ikut ter-commit karena itu (2026-08-06, R2.1).
/test-results/
/playwright-report/

# Runtime uploads — user/device images added on-demand, never committed as seed
# (device-catalog bulk photos were dropped 2026-07-25; images are added later per model)
flowserv-api/public/uploads/*
!flowserv-api/public/uploads/.gitkeep

# Device-catalog source exports (provenance only — importer reads the derived
# JSON; converted via scripts-convert-devices.py). Never commit the raw xlsx.
*.xlsx

# DB backups (pg_dump) — never commit
backups/
